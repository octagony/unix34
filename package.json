{
	"name": "unix34",
	"version": "0.0.1",
	"workspaces": [
		"app/*"
	],
	"scripts": {
		"build:frontend": "npm run build --workspace=app/frontend",
		"dev:frontend": "npm run dev --workspace=app/frontend",
		"generate:frontend": "npm run generate --workspace=app/frontend",
		"preview:frontend": "npm run preview --workspace=app/frontend",
		"postinstall:frontend": "npm run postinstall --workspace=app/frontend",
		"dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
		"lint:frontend": "npm run lint --workspace=app/frontend",
    "lint:fix:frontend": "npm run lint:fix --workspace=app/frontend",
    "format:frontend": "npm run format --workspace=app/frontend",
    "format:check:frontend": "npm run check --workspace=app/frontend"
	},
	"devDependencies": {
		"concurrently": "^8.2.2"
	}
}